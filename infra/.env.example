# PostgreSQL Connection Details
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=pos
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos_dev_password

# Connection String / URL format
DATABASE_URL=postgresql://pos:pos_dev_password@localhost:5433/pos

# Production Security Keys (MUST be distinct >=32-char random values in production)
POS_JWT_SECRET=replace-with-32-plus-char-random-jwt-signing-secret
POS_ENCRYPTION_KEY=replace-with-distinct-32-plus-char-aes-encryption-key

# Live M-Pesa Daraja Security (leave blank while using fake M-Pesa sandbox)
POS_MPESA_ENABLED=false
POS_MPESA_ALLOWED_CALLBACK_IPS=
POS_MPESA_CALLBACK_SECRET=
